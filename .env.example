# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Without these, local dev still works: applications are printed to the terminal instead.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Loopedy Match (the /match prototype). Optional: without a key it runs in Wizard of Oz mode.
# Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=your-anthropic-api-key
# Force the simulated AI step even with a key set:
# LOOPEDY_WIZARD=1
# Optional: override the model used for matching.
# LOOPEDY_MODEL=claude-sonnet-5-5
